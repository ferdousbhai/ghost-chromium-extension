{
  "manifest_version": 3,
  "name": "Ghost",
  "version": "0.5.0",
  "description": "An agent works your tabs: chat with it in the side panel on your own OpenRouter account, or lend the tabs to a ghost running in ghostd.",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/ghost-16.png",
    "32": "icons/ghost-32.png",
    "48": "icons/ghost-48.png",
    "128": "icons/ghost-128.png"
  },
  "permissions": [
    "debugger",
    "storage",
    "alarms",
    "sidePanel",
    "identity"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ghost",
    "default_icon": {
      "16": "icons/ghost-16.png",
      "32": "icons/ghost-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open Ghost"
    }
  }
}
