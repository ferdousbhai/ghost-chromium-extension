{
  "manifest_version": 3,
  "name": "Ghost browser relay",
  "version": "0.2.2",
  "description": "Lets a ghost running in ghostd drive the tabs of this browser \u2014 the one you are already signed into.",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/ghost-16.png",
    "32": "icons/ghost-32.png",
    "48": "icons/ghost-48.png",
    "128": "icons/ghost-128.png"
  },
  "permissions": [
    "debugger",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ghost browser relay",
    "default_icon": {
      "16": "icons/ghost-16.png",
      "32": "icons/ghost-32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open the Ghost relay popup"
    }
  }
}
